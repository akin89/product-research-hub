# Backend API Port
PORT=5001

# Amazon Product Advertising API 5.0 Credentials
# Get these from your Amazon Associates account
AMAZON_PAAPI_ACCESS_KEY=CHANGE_ME
AMAZON_PAAPI_SECRET_KEY=CHANGE_ME
AMAZON_PAAPI_PARTNER_TAG=CHANGE_ME

# Amazon Host and Region
AMAZON_PAAPI_HOST=webservices.amazon.co.uk
AMAZON_PAAPI_REGION=eu-west-1

# RapidAPI Real-Time eBay Data Key
RAPIDAPI_EBAY_KEY=CHANGE_ME

